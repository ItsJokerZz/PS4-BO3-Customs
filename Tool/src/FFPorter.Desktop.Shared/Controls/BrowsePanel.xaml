<UserControl x:Class="FFPorter.Desktop.Controls.BrowsePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </UserControl.Resources>

  <Border Style="{StaticResource Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ==== toolbar ==== -->
      <DockPanel Margin="16,12,10,8">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBox x:Name="SearchBox" Width="190" MinHeight="30" Margin="0,0,6,0" TextChanged="SearchChanged" ToolTip="Search maps by name or author"/>
          <Button x:Name="RefreshButton" Style="{StaticResource Button.Icon}" Content="&#xE72C;" Click="RefreshClick" ToolTip="Reload the map list"/>
          <Button x:Name="ConsoleButton" Click="ConsoleClick" Padding="10,5" MinHeight="30" Margin="6,0,0,0" ToolTip="Console (FTP) and map list settings">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE968;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Console"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Community maps" Style="{StaticResource Text.Heading}"/>
          <Border Style="{StaticResource Chip}" Margin="8,0,0,0"><TextBlock x:Name="CountText" Text="0" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"/></Border>
        </StackPanel>
      </DockPanel>

      <!-- ==== list ==== -->
      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="10,0,6,0">
          <ItemsControl x:Name="MapList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Margin="0,0,4,8" Padding="0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="104" Height="78" Margin="12" CornerRadius="8" Background="{DynamicResource Bg.Raised}" ClipToBounds="True">
                      <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,14,14,14" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding HasVersion, Converter={StaticResource Visible}}">
                          <TextBlock Text="{Binding VersionLabel}" FontSize="10.5" Foreground="{DynamicResource Text.Secondary}"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding ByLine}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="12.5" Margin="0,6,0,0" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                 Visibility="{Binding HasDescription, Converter={StaticResource Visible}}"/>
                      <Grid Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding StageText}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                      <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                 Visibility="{Binding ShowStatus, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,14,14,14" VerticalAlignment="Center">
                      <Button Content="Install" Style="{StaticResource Button.Primary}" MinHeight="32" Padding="14,6"
                              Click="InstallClick" IsEnabled="{Binding CanInstall}" Visibility="{Binding IsIdle, Converter={StaticResource Visible}}"/>
                      <Button Content="Cancel" MinHeight="32" Padding="14,6"
                              Click="CancelClick" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="Collapsed">
          <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="28" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyText" Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="380" Margin="0,12,0,0"/>
        </StackPanel>
      </Grid>

      <!-- ==== footer ==== -->
      <Border Grid.Row="2" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0" Padding="16,9">
        <DockPanel>
          <TextBlock x:Name="TargetText" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Margin="12,0,0,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Text="Pick a map and it is installed to your console."/>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

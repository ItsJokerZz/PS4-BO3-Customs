<Window x:Class="FFPorter.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:FFPorter.Desktop.Controls"
        Title="PC → PS4 FF Converter" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.App}" Foreground="{DynamicResource Text.Primary}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
  </Window.Resources>
  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ==== header ==== -->
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource Accent}" VerticalAlignment="Center">
        <TextBlock Text="FF" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Accent.Text}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="14,0,24,0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" Text="PC → PS4 FF Converter" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubtitleText" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"
                   Text="Drop maps, mods, weapons and zones. The files that belong with them and the tools are found automatically."/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="GameFolderButton" Click="ChooseGameFolderClick" Padding="12,6" Margin="0,0,6,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7FC;" Margin="0,0,8,0"/>
            <TextBlock x:Name="GameFolderLabel" Text="Game files" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0"/>
            <TextBlock x:Name="GameFolderText" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
          </StackPanel>
        </Button>
        <Button x:Name="OutputButton" Click="ChooseOutputClick" Padding="12,6" ToolTip="Change where converted files go">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem x:Name="DefaultOutputItem" Header="Use the default folder" Click="DefaultOutputClick"/>
            </ContextMenu>
          </Button.ContextMenu>
          <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B7;" Margin="0,0,8,0"/>
            <TextBlock x:Name="OutputLabel" Text="Output" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0"/>
            <TextBlock x:Name="OutputText" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
          </StackPanel>
        </Button>
        <Button Style="{StaticResource Button.Icon}" Content="&#xE8A7;" Margin="6,0,0,0" Click="OpenOutputClick" ToolTip="Open the output folder"/>
      </StackPanel>
    </Grid>

    <!-- ==== queue and report ==== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="360"/>
        <ColumnDefinition Width="14"/>
        <ColumnDefinition Width="6*" MinWidth="440"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="16,12,10,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="RemoveButton" Style="{StaticResource Button.Icon}" Content="&#xE74D;" Click="RemoveClick" ToolTip="Remove the selected items (Delete)"/>
              <Button x:Name="ClearButton" Style="{StaticResource Button.Icon}" Content="&#xE894;" Click="ClearClick" ToolTip="Clear the queue" Margin="0,0,6,0"/>
              <Button x:Name="AddFolderButton" Click="AddFolderClick" Padding="10,5" MinHeight="30" ToolTip="Add a folder: everything convertible inside it is found">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8F4;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Add folder"/></StackPanel>
              </Button>
              <Button x:Name="AddFilesButton" Click="AddFilesClick" Padding="10,5" MinHeight="30" Margin="6,0,0,0" ToolTip="Add fastfiles (.ff)">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Add files"/></StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Queue" Style="{StaticResource Text.Heading}"/>
              <Border Style="{StaticResource Chip}" Margin="8,0,0,0"><TextBlock x:Name="CountText" Text="0" FontSize="11.5" Foreground="{DynamicResource Text.Secondary}"/></Border>
            </StackPanel>
          </DockPanel>

          <Grid x:Name="EmptyQueue" Grid.Row="1" Margin="12,0,12,12">
            <Rectangle RadiusX="10" RadiusY="10" Stroke="{DynamicResource Border.Default}" StrokeThickness="1.2" StrokeDashArray="4 3" SnapsToDevicePixels="True"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="28" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center"/>
              <TextBlock Text="Drop anything here" Style="{StaticResource Text.Heading}" FontSize="15" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              <TextBlock x:Name="EmptyQueueText" Style="{StaticResource Text.Body}" TextAlignment="Center" MaxWidth="300" Margin="0,6,0,0"
                         Text="Maps, mods, weapons and zones: .ff files or whole folders."/>
            </StackPanel>
          </Grid>

          <ListBox x:Name="JobList" Grid.Row="1" Margin="8,0,8,8" SelectionMode="Extended" ItemContainerStyle="{StaticResource ListItem.Row}"
                   SelectionChanged="JobSelectionChanged" KeyDown="JobListKeyDown">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ToolTip="{Binding MainFile}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding State}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                      <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Padding="6,0,6,1">
                        <TextBlock Text="{Binding GameLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <Grid Margin="0,8,0,1" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <ProgressBar Height="3" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding StageText}" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Report.PercentText}" Tag="{Binding Report.ScoreGrade}" Style="{StaticResource GradeText}" FontWeight="SemiBold" FontSize="13.5"
                               HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" Visibility="{Binding HasScore, Converter={StaticResource Visible}}"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Size}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Style="{StaticResource Splitter}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <controls:FidelityPanel x:Name="Fidelity"/>
        </Grid>
      </Border>
    </Grid>

    <!-- ==== log ==== -->
    <controls:LogView x:Name="Log" Grid.Row="2" Height="220" Margin="0,14,0,0" Visibility="Collapsed" SaveName="converter.log"/>

    <!-- ==== status and convert ==== -->
    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <DockPanel>
            <TextBlock x:Name="PercentText" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Typography.NumeralAlignment="Tabular" Margin="12,0,0,0"/>
            <TextBlock TextTrimming="CharacterEllipsis">
              <Run x:Name="StatusText" Text="Drop something to convert" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}"/>
              <Run x:Name="DetailText" Text="" Foreground="{DynamicResource Text.Muted}"/>
            </TextBlock>
          </DockPanel>
          <ProgressBar x:Name="Progress" Maximum="1" Margin="0,9,0,0" Visibility="Hidden"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ToggleButton x:Name="LogToggle" Style="{StaticResource Toggle.Ghost}" Checked="LogToggled" Unchecked="LogToggled" ToolTip="Show everything the converter printed">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Text.Icon}" Text="&#xE756;" Margin="0,0,8,0"/><TextBlock Text="Log"/></StackPanel>
          </ToggleButton>
          <Button x:Name="CancelButton" Content="Cancel" Margin="10,0,0,0" MinHeight="36" Padding="16,6" Click="CancelClick" Visibility="Collapsed"/>
          <Button x:Name="ConvertButton" Style="{StaticResource Button.Primary}" Margin="10,0,0,0" Click="ConvertClick" IsEnabled="False">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Accent.Text}"/>
              <TextBlock Text="Convert"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
